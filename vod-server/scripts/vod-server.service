[Unit]
Description=CARI VOD Server - Video transcoding and serving daemon
Documentation=https://github.com/caritechsolutions/cari-iptv
After=network.target

[Service]
Type=simple
User=vod-server
Group=vod-server
ExecStart=/usr/local/bin/vod-server -c /etc/vod-server/vod-server.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Security hardening
ProtectSystem=strict
ReadWritePaths=/var/lib/vod-server /var/log/vod-server /var/run /etc/vod-server /etc/letsencrypt /etc/systemd/system
ProtectHome=true
PrivateTmp=true

# Allow binding to privileged ports (port 80 for ACME HTTP listener)
# Note: AmbientCapabilities is incompatible with NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Bounding set includes caps needed by sudo for certbot/systemctl
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_AUDIT_WRITE CAP_FOWNER CAP_CHOWN CAP_DAC_READ_SEARCH

# Allow access to configured mount paths
# Add additional ReadWritePaths for custom library paths, e.g.:
# ReadWritePaths=/mnt/vod-storage

[Install]
WantedBy=multi-user.target
